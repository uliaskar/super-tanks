# Super Tanks harness — model backend configuration.
# Copy this file to harness/.env and fill in your own key:
#     cp harness/.env.example harness/.env
# .env is read by harness/backend.py at import time. NEVER commit your real key.
# A real environment variable always overrides the value in this file.

# --- required -------------------------------------------------------------
# Your provider API key. Never printed by the harness.
OPENAI_API_KEY=sk-your-key-here

# --- optional -------------------------------------------------------------
# OpenAI-compatible endpoint. Pick ONE of the three (uncomment it) or leave the
# default. Whatever endpoint you set, OPENAI_API_KEY must be a key for it.
#
#   OpenAI (default):
# OPENAI_BASE_URL=https://api.openai.com/v1
#
#   Kimi / Moonshot (cheapest for the banking suite; backend applies the
#   developer->system and empty-content fixes automatically):
# OPENAI_BASE_URL=https://api.moonshot.ai/v1
#
#   OpenRouter (one key, many models):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model id for the chosen endpoint.
#   OpenAI:      gpt-4o-mini   (default)
#   Moonshot:    kimi-k3
#   OpenRouter:  e.g. moonshotai/kimi-k2  (see openrouter.ai/models)
OPENAI_MODEL=kimi-k3   # for Kimi/Moonshot; gpt-4o-mini for OpenAI



# --- cost note ------------------------------------------------------------
# A full banking-suite sweep (both configs, important_instructions attack) is
# ~900 model calls / ~1.5M prompt tokens. On Kimi/Moonshot that is under ~2 USD.
# On GPT-4o / Claude-class models it costs noticeably more — start with --validate
# (free, no calls) and consider a small run before the full sweep.
